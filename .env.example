GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Redis Configuration for Celery Background Tasks
REDIS_URL=redis://localhost:6379/0

# Email Configuration for Retention Emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_USE_TLS=true

# Optional: Override all retention emails to be sent to this address for testing
RETENTION_TEST_EMAIL=your-test-email@example.com
